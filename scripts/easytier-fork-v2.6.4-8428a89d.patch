     use super::*;
 
+    #[test]
+    fn test_null_pointer_returns_error_without_panicking() {
+        unsafe {
+            assert_eq!(set_tun_fd(std::ptr::null(), -1), -1);
+            assert_eq!(parse_config(std::ptr::null()), -1);
+            assert_eq!(run_network_instance(std::ptr::null()), -1);
+            assert_eq!(retain_network_instance(std::ptr::null(), 1), -1);
+            assert_eq!(collect_network_infos(std::ptr::null_mut(), 1), -1);
+        }
+        // 错误信息应可读取且可释放
+        let mut out: *const std::ffi::c_char = std::ptr::null();
+        unsafe {
+            get_error_msg(&mut out);
+            assert!(!out.is_null());
+            free_string(out);
+        }
+    }
+
+    #[test]
+    fn test_invalid_fd_returns_error() {
+        let cfg_str = r#"
+            inst_name = "test"
+            network = "test_network"
+        "#;
+        let cstr = std::ffi::CString::new(cfg_str).unwrap();
+        let mut out: *const std::ffi::c_char = std::ptr::null();
+        unsafe {
+            assert_eq!(parse_config(cstr.as_ptr()), 0);
+            assert_eq!(run_network_instance(cstr.as_ptr()), 0);
+            // -1 是无效 fd
+            assert_eq!(set_tun_fd(cstr.as_ptr(), -1), -1);
+            get_error_msg(&mut out);
+            assert!(!out.is_null());
+            free_string(out);
+            // 重复启动同一 instance 应失败
+            assert_eq!(run_network_instance(cstr.as_ptr()), -1);
+            get_error_msg(&mut out);
+            assert!(!out.is_null());
+            free_string(out);
+            // 清理
+            assert_eq!(retain_network_instance(std::ptr::null(), 0), 0);
+        }
+    }
+
+    #[test]
+    fn test_free_string_accepts_null_and_repeated() {
+        free_string(std::ptr::null());
+    }
